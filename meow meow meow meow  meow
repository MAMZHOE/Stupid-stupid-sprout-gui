local phone = {
    x = 160,
    y = 100,
    w = 240,
    h = 500,
    drag = false,
    dragOffsetX = 0,
    dragOffsetY = 0,
    open = true,
    dialText = "",
    keypadButtons = {},
    toggleButton = { x = 0, y = 0, w = 90, h = 28 }
}

local keypadLabels = {"1", "2", "3", "4", "5", "6", "7", "8", "9", "*", "0", "#"}

local function clamp(value, min, max)
    if value < min then return min end
    if value > max then return max end
    return value
end

local function pointInsideRect(px, py, rx, ry, rw, rh)
    return px >= rx and px <= rx + rw and py >= ry and py <= ry + rh
end

local function getPointerInput()
    local touches = love.touch.getTouches()
    if #touches > 0 then
        local id = touches[1]
        local x, y = love.touch.getPosition(id)
        return x, y, true
    end

    local x, y = love.mouse.getPosition()
    return x, y, love.mouse.isDown(1)
end

local function updateLayout()
    phone.toggleButton.x = phone.x + (phone.w * 0.5) - 45
    phone.toggleButton.y = phone.y + phone.h - 42

    phone.keypadButtons = {}
    local cellW, cellH = 50, 38
    local gapX, gapY = 12, 12
    local startX = phone.x + 22
    local startY = phone.y + 245

    for i = 1, #keypadLabels do
        local row = math.floor((i - 1) / 3)
        local col = (i - 1) % 3
        local bx = startX + col * (cellW + gapX)
        local by = startY + row * (cellH + gapY)

        table.insert(phone.keypadButtons, {
            label = keypadLabels[i],
            x = bx,
            y = by,
            w = cellW,
            h = cellH
        })
    end
end

local function appendDial(value)
    if value == "<" then
        phone.dialText = phone.dialText:sub(1, -2)
        return
    end

    if value == "CALL" then
        if phone.dialText ~= "" then
            phone.dialText = "Calling... " .. phone.dialText
        end
        return
    end

    if #phone.dialText >= 18 then
        return
    end

    phone.dialText = phone.dialText .. value
end

function love.load()
    love.window.setTitle("Flip Phone UI")
    love.graphics.setBackgroundColor(0.12, 0.12, 0.15)
    love.window.setMode(480, 950, {
        resizable = true,
        minwidth = 320,
        minheight = 480
    })
    updateLayout()
end

function love.resize(w, h)
    phone.x = (w - phone.w) * 0.5
    phone.y = (h - phone.h) * 0.5
    updateLayout()
end

function love.update(dt)
    local mx, my, pointerDown = getPointerInput()

    if pointerDown then
        if not phone.drag and pointInsideRect(mx, my, phone.x, phone.y, phone.w, phone.h) then
            phone.drag = true
            phone.dragOffsetX = mx - phone.x
            phone.dragOffsetY = my - phone.y
        end

        if phone.drag then
            phone.x = mx - phone.dragOffsetX
            phone.y = my - phone.dragOffsetY
        end
    else
        phone.drag = false
    end

    local screenW, screenH = love.graphics.getWidth(), love.graphics.getHeight()
    phone.x = clamp(phone.x, 0, screenW - phone.w)
    phone.y = clamp(phone.y, 0, screenH - phone.h)

    updateLayout()
end

local function handleButtonPress(x, y)
    if pointInsideRect(x, y, phone.toggleButton.x, phone.toggleButton.y, phone.toggleButton.w, phone.toggleButton.h) then
        phone.open = not phone.open
        return true
    end

    for _, btn in ipairs(phone.keypadButtons) do
        if pointInsideRect(x, y, btn.x, btn.y, btn.w, btn.h) then
            appendDial(btn.label)
            return true
        end
    end

    return false
end

function love.mousepressed(x, y, button, istouch)
    if button == 1 then
        handleButtonPress(x, y)
    end
end

function love.touchpressed(id, x, y, dx, dy, pressure)
    handleButtonPress(x, y)
end

